# ═══════════════════════════════════════════════════════════════════
#  AsterA Coach — zmienne środowiskowe
#  Skopiuj do .env i uzupełnij. .env NIGDY nie trafia do repozytorium.
#
#  Po uzupełnieniu uruchom:  npm run konfig
#  Zbuduje web/konfig.js i front sam przełączy się na Supabase.
#  Puste SUPABASE_URL = tryb lokalny (serwer deweloperski /api/*).
# ═══════════════════════════════════════════════════════════════════

# ── SUPABASE (produkcja) ──────────────────────────────────────────
# Panel Supabase → Project Settings → API Keys
SUPABASE_URL=

# Klucz PUBLICZNY — jedyny, który wolno pokazać w przeglądarce.
# Nowe projekty (2026): sb_publishable_...
SUPABASE_PUBLISHABLE_KEY=

# Starszy odpowiednik. Wypełnij TYLKO wtedy, gdy projekt nie ma jeszcze
# klucza publishable. Supabase wygasza klucze legacy do końca 2026 roku.
SUPABASE_ANON_KEY=

# ── KLUCZ SEKRETNY — NIE dla frontu ───────────────────────────────
# Nowe projekty: sb_secret_...   Starsze: service_role.
# OMIJA RLS. `npm run konfig` go POMIJA i nigdy nie wpisze do konfig.js.
# Edge Function dostaje go od platformy sama — nie ustawia się go ręcznie.
# Zostawiony tu wyłącznie dla narzędzi uruchamianych po stronie serwera.
SUPABASE_SECRET_KEY=

# Nazwa prywatnego bucketu na materiały
SUPABASE_BUCKET=materialy

# ── ADRESY ────────────────────────────────────────────────────────
# Dokąd Supabase odsyła po kliknięciu w link zaproszenia albo resetu.
# Ten sam adres musi być na liście Redirect URLs w panelu Supabase.
ADRES_APLIKACJI=http://127.0.0.1:8910

# ── SERWER DEWELOPERSKI (tylko lokalnie) ─────────────────────────
PORT=8910
SEKRET_SESJI=
DATABASE_URL=postgresql://postgres@/coach?host=/tmp&port=5433
