# ═══════════════════════════════════════════════════════════════════
#  AsterA Coach — zmienne środowiskowe
#  Skopiuj do .env i uzupełnij. .env NIGDY nie trafia do repozytorium.
# ═══════════════════════════════════════════════════════════════════

# Po uzupełnieniu uruchom:  npm run konfig
# Zbuduje web/konfig.js i front sam przełączy się na Supabase.
# Puste SUPABASE_URL = tryb lokalny (serwer deweloperski /api/*).

# ── SUPABASE (produkcja) ──────────────────────────────────────────
# Panel Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Klucz serwisowy OMIJA RLS. Nigdy we froncie, nigdy w repozytorium.
# Tylko na serwerze, do zadań administracyjnych (zakładanie kont).
SUPABASE_SERVICE_ROLE_KEY=

# Nazwa prywatnego bucketu na materiały
SUPABASE_BUCKET=materialy

# ── ADRESY ────────────────────────────────────────────────────────
# Dokąd Supabase odsyła po kliknięciu w link resetu hasła
ADRES_APLIKACJI=http://127.0.0.1:8910

# ── SERWER DEWELOPERSKI (tylko lokalnie) ─────────────────────────
PORT=8910
SEKRET_SESJI=
DATABASE_URL=postgresql://postgres@/coach?host=/tmp&port=5433
